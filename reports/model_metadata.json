{
  "model_family": "rf",
  "feature_set": "tree",
  "input_columns": [
    "CreditScore",
    "Age",
    "Tenure",
    "Balance",
    "NumOfProducts",
    "HasCrCard",
    "IsActiveMember",
    "Geography"
  ],
  "excluded_columns": [
    "EstimatedSalary"
  ],
  "hyperparameters": {
    "n_estimators": 500,
    "random_state": 42,
    "n_jobs": -1,
    "min_samples_leaf": 5,
    "max_features": "sqrt",
    "max_depth": 10
  },
  "calibrator": "sigmoid",
  "decision_rule": "contactar si p_calibrada > t* = c / (s * V) (spec 004)",
  "threshold": 0.16666666666666666,
  "assumptions": {
    "customer_value_eur": 1000.0,
    "contact_cost_eur": 50.0,
    "retention_success_rate": 0.3
  },
  "trained_on": {
    "partition": "train",
    "n_rows": 6000
  },
