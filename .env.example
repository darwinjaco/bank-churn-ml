# LLM opcional para /explain (spec 005 §6). Copiar a .env (no se versiona) o usar secretos del Space.
# NVIDIA NIM:  LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Máximo de llamadas al LLM por hora (ventana deslizante, por proceso). Vacío = 30; 0 lo desactiva.
LLM_MAX_CALLS_PER_HOUR=
